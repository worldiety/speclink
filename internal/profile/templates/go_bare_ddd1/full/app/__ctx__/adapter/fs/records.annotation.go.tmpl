package fs

import (
	"{{.Module}}/app/{{.Context}}"
	"{{.Module}}/requirements/dec"
	"{{.Module}}/requirements/fun/record"
	"github.com/worldiety/speclink/spec"
)

// The adapter keeps a shape of its own and maps to it, so what is promised is
// this struct rather than the domain model.
//
// Without this statement the promise would sit on the domain type, which is the
// stricter reading and the right default: two structs in two packages look
// identical whether one maps to the other or neither knows the other exists,
// and nothing but a statement can tell them apart. With it, the domain model
// may be restructured freely and this struct may not.
var _ = spec.For[RecordStore](
	spec.StoredAs[{{.Context}}.Record](),
	spec.Rationale("What is written down is the half that cannot be changed after the fact; the domain model above it stays free to move."),
)

// The stored fields trace to requirements in their own right. What is on disk
// outlives the domain model that produced it, so it answers for itself rather
// than through the type it happens to mirror today.
var _ = spec.ForField[RecordStore]("ID", spec.Satisfies(record.RRecordLookup))
var _ = spec.ForField[RecordStore]("Title", spec.Satisfies(record.RRecordCreate))
var _ = spec.ForField[RecordStore]("State", spec.Satisfies(dec.RDecRecordState))
